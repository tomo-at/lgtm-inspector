{
  "manifest_version": 3,
  "name": "LGTM Inspector",
  "version": "1.0.0",
  "description": "Component-level inspection and annotation for localhost development",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "http://[::1]/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://[::1]/*"
      ],
      "js": ["content.js"],
      "run_at": "document_end"
    }
  ],
  "commands": {
    "toggle-inspector": {
      "suggested_key": {
        "mac": "Command+I",
        "default": "Ctrl+I"
      },
      "description": "Toggle LGTM Inspector (customize at chrome://extensions/shortcuts)"
    }
  },
  "action": {
    "default_title": "LGTM Inspector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
