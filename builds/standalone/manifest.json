{
  "manifest_version": 3,
  "name": "LGTM Inspector (Standalone)",
  "version": "1.0.0",
  "description": "Component-level inspection — copy annotations to clipboard",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "tabs",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "mac": "Command+Shift+I",
        "default": "Ctrl+Shift+I"
      },
      "description": "Toggle LGTM Inspector (customize at chrome://extensions/shortcuts)"
    }
  },
  "action": {
    "default_title": "LGTM Inspector (Standalone)",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
